rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuth() { return request.auth != null; }
    function authEmail() { return request.auth.token.email; }
    function isSuperAdmin() {
      return isAuth() && request.auth.token.admin == true;
    }
    function canSubmit() {
      return isAuth() && (!exists(/databases/$(database)/documents/submission_blocks/$(request.auth.uid))
        || get(/databases/$(database)/documents/submission_blocks/$(request.auth.uid)).data.expires_at <= request.time);
    }
    // True if none of `fields` changed between the existing doc and the
    // incoming write. Use this to lock aggregate/moderation fields so a
    // normal client write can never move them — only trusted server code
    // (Cloud Functions, running with the Admin SDK) bypasses rules entirely
    // and can update them.
    function unchanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(fields) == false;
    }
    function strLen(v, max) {
      return v is string && v.size() <= max;
    }
    function validDraftCoordinates(data) {
      return (data.lat == null && data.lng == null)
        || (data.lat is number && data.lat >= -90 && data.lat <= 90
            && data.lng is number && data.lng >= -180 && data.lng <= 180);
    }
    // Rules cannot iterate an arbitrary list, so check every permitted slot.
    function validSpotStringList(value, maxItems, maxLength) {
      return value is list && value.size() <= maxItems
        && (value.size() < 1 || strLen(value[0], maxLength))
        && (value.size() < 2 || strLen(value[1], maxLength))
        && (value.size() < 3 || strLen(value[2], maxLength))
        && (value.size() < 4 || strLen(value[3], maxLength))
        && (value.size() < 5 || strLen(value[4], maxLength))
        && (value.size() < 6 || strLen(value[5], maxLength))
        && (value.size() < 7 || strLen(value[6], maxLength))
        && (value.size() < 8 || strLen(value[7], maxLength))
        && (value.size() < 9 || strLen(value[8], maxLength))
        && (value.size() < 10 || strLen(value[9], maxLength));
    }

    // ── Public spots ─────────────────────────────────────────────────────────
    match /spots/{spotId} {
      function isSpotOwner() {
        return resource.data.get('created_by_uid', null) == request.auth.uid
          || (resource.data.get('created_by_uid', null) == null
            && authEmail() is string && authEmail().size() > 0
            && resource.data.get('created_by', null) == authEmail());
      }
      function validOwnerSpotEdit() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return changed.hasOnly(['title', 'description', 'tags', 'cost',
                                'access_difficulty', 'parking', 'best_time', 'directions'])
          && (!changed.hasAny(['title']) || (strLen(request.resource.data.get('title', null), 100)
                                            && request.resource.data.title.size() > 0))
          && (!changed.hasAny(['description']) || strLen(request.resource.data.get('description', null), 2000))
          && (!changed.hasAny(['tags']) || validSpotStringList(request.resource.data.get('tags', null), 10, 40))
          && (!changed.hasAny(['cost']) || request.resource.data.get('cost', null) in [null, '', 'free', 'paid', 'donation'])
          && (!changed.hasAny(['access_difficulty']) || request.resource.data.get('access_difficulty', null) in [null, '', 'easy', 'moderate', 'hard'])
          && (!changed.hasAny(['parking']) || request.resource.data.get('parking', null) in [null, '', 'yes', 'no', 'street', 'paid'])
          && (!changed.hasAny(['best_time']) || validSpotStringList(request.resource.data.get('best_time', null), 5, 30))
          && (!changed.hasAny(['directions']) || strLen(request.resource.data.get('directions', null), 1000));
      }
      // Public discovery and shared links can read only public visible records.
      // Owners retain access to their own records; moderation tools need all.
      allow read: if (resource.data.is_public == true
        && resource.data.status in ['published', 'pending_trust'])
        || (isAuth() && (
          ('created_by_uid' in resource.data && resource.data.created_by_uid == request.auth.uid)
          || ('created_by' in resource.data && resource.data.created_by == authEmail())))
        || isSuperAdmin();

      // All creates go through submitSpot. The callable validates the signed
      // Firebase identity, ownership, moderation state, and rate limits.
      allow create: if false;

      // Content details are directly editable by the owner. Publication,
      // location, provenance, moderation, counters and timestamps are not.
      // Trusted Admin SDK operations bypass these client rules.
      allow update: if isAuth() && ((isSpotOwner() && validOwnerSpotEdit())
        || (isSuperAdmin() && unchanged(['status', 'flag_count', 'auto_flag_moderation'])));

      allow delete: if isAuth() && (
        resource.data.created_by == authEmail() || resource.data.created_by_uid == request.auth.uid || isSuperAdmin()
      );
    }

    // Unpublished drafts are stored outside /spots and are private to the
    // registered Firebase account that created them. Ownership can never be
    // reassigned by a client update.
    match /spot_drafts/{draftId} {
      // Older clients preflight-get a generated draft ID before its first
      // create. Reading a missing document reveals no data; existing drafts
      // remain strictly owner-only. List queries must still prove ownership.
      allow get: if isAuth() && (
        !exists(/databases/$(database)/documents/spot_drafts/$(draftId))
        || resource.data.owner_uid == request.auth.uid
      );
      allow list: if isAuth() && resource.data.owner_uid == request.auth.uid;
      allow delete: if isAuth() && resource.data.owner_uid == request.auth.uid;
      allow create: if isAuth()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.owner_uid == request.auth.uid
        && strLen(request.resource.data.title, 100)
        && strLen(request.resource.data.description, 2000)
        && validDraftCoordinates(request.resource.data);
      allow update: if isAuth()
        && resource.data.owner_uid == request.auth.uid
        && request.resource.data.owner_uid == request.auth.uid
        && unchanged(['owner_uid', 'created_at'])
        && strLen(request.resource.data.title, 100)
        && strLen(request.resource.data.description, 2000)
        && validDraftCoordinates(request.resource.data);
    }

    // Server-only idempotency records prevent a resumed draft from creating
    // two public spots. Clients cannot inspect or forge these markers.
    match /spot_publications/{publicationId} {
      allow read, write: if false;
    }

    // ── Per-user spot ratings (one doc per user per spot; aggregates are  ──────
    // recomputed server-side by a Cloud Function trigger — never trust a
    // client-submitted average).
    match /spot_ratings/{ratingId} {
      // A preflight get for the signed-in user's own (possibly missing) rating
      // must return an empty document instead of permission-denied. Existing
      // documents remain restricted to their author/super-admin.
      allow get: if isAuth() && (
        !exists(/databases/$(database)/documents/spot_ratings/$(ratingId))
        || resource.data.user_id == request.auth.uid
        || isSuperAdmin());
      allow list: if isAuth() && (resource.data.user_id == request.auth.uid || isSuperAdmin());
      // ratingId MUST be `${spotId}_${uid}` so a user can only ever create
      // or overwrite *their own* rating for a given spot (built-in de-dupe).
      allow create, update: if canSubmit()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/spots/$(request.resource.data.spot_id))
        && get(/databases/$(database)/documents/spots/$(request.resource.data.spot_id)).data.get('created_by_uid', '') != request.auth.uid
        && get(/databases/$(database)/documents/spots/$(request.resource.data.spot_id)).data.get('created_by', '') != authEmail()
        && ratingId == request.resource.data.spot_id + '_' + request.auth.uid
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.keys().hasOnly(['spot_id', 'user_id', 'overall', 'access', 'condition', 'safety', 'crowdedness', 'crowdedness_report', 'schema', 'updated_date'])
        && request.resource.data.schema == 2
        // A document may contain star ratings, an independent crowdedness
        // report, or both (merge writes preserve the other half).
        && (
          (!request.resource.data.keys().hasAny(['overall', 'access', 'condition', 'safety', 'crowdedness'])
            && request.resource.data.crowdedness_report in ['quiet', 'moderate', 'crowded'])
          || (request.resource.data.overall is number && request.resource.data.overall >= 1 && request.resource.data.overall <= 5
            && request.resource.data.access is number && request.resource.data.access >= 0 && request.resource.data.access <= 5
            && request.resource.data.condition is number && request.resource.data.condition >= 0 && request.resource.data.condition <= 5
            && request.resource.data.safety is number && request.resource.data.safety >= 0 && request.resource.data.safety <= 5
            && (!('crowdedness' in request.resource.data)
              || (request.resource.data.crowdedness is number && request.resource.data.crowdedness >= 0 && request.resource.data.crowdedness <= 5)))
        )
        && (!('crowdedness_report' in request.resource.data)
          || request.resource.data.crowdedness_report in ['quiet', 'moderate', 'crowded']);
      allow delete: if isSuperAdmin();
    }

    // Legacy single-value ratings collection — kept read-only for existing
    // data; new writes should go through /spot_ratings above.
    match /ratings/{ratingId} {
      allow read: if isAuth();
      allow create: if false;
    }

    // ── POI community photos and ratings (public read, auth write) ────────────
    match /poi_photos/{docId} {
      allow read: if true;
      // Only trusted review/publishing Functions may attach public images.
      allow create, update: if false;
      allow delete: if isSuperAdmin() || (isAuth() && resource.data.created_by_uid == request.auth.uid);
    }

    // Server-reviewed /new submissions and deliberate links. Clients cannot
    // publish, approve, or alter either record directly.
    match /poi_enrichment_submissions/{docId} {
      allow read: if isSuperAdmin() || (isAuth() && resource.data.owner_uid == request.auth.uid);
      allow write: if false;
    }
    match /poi_enrichments/{osmRef} {
      allow read: if true;
      allow write: if false;
    }

    match /poi_ratings/{docId} {
      allow read: if true;
      // The callable checks all existing arbitrary-ID records for this UID and
      // POI before a create or edit. Rules cannot query that legacy set safely.
      allow create, update: if false;
      allow delete: if isSuperAdmin() || (isAuth() && resource.data.created_by_uid == request.auth.uid);
    }

    // Social references are validated and written only by callable Cloud
    // Functions. Public clients may read active records for place details;
    // admins read every status for moderation. No client can forge provider,
    // content ID, ownership, timestamps, or moderation state.
    match /social_posts/{docId} {
      allow read: if resource.data.status == 'active' || isSuperAdmin();
      allow write: if false;
    }

    // ── Community moderation: flags (report a spot) ────────────────────────────
    // One flag per user per spot: docId MUST be `${spotId}_${reporterEmail}`.
    // flag_count / status on the target spot are recomputed server-side only.
    match /flags/{flagId} {
      allow read: if isSuperAdmin();
      // Report creation is server-only after the API cutover. Cached clients use submitReport.
      allow create: if false;
      // Moderation is transactional in adminResolveFlag; account cleanup uses
      // Admin SDK and the onWrite trigger reconciles deleted flags.
      allow update, delete: if false;
    }

    // ── Votes (up/down) — one vote per user per spot ───────────────────────────
    match /votes/{voteId} {
      allow read: if isAuth() && (resource.data.user_email == authEmail() || isSuperAdmin());
      allow create, update: if isAuth() && request.auth.token.email_verified == true
        && voteId == authEmail() + '_' + request.resource.data.spot_id
        && request.resource.data.user_email == authEmail()
        && request.resource.data.keys().hasOnly(['user_email', 'spot_id', 'type', 'created_date'])
        && request.resource.data.type in ['up', 'down'];
      allow delete: if isAuth() && resource.data.user_email == authEmail();
    }

    // ── Bookmarks — private to each user ───────────────────────────────────────
    match /bookmarks/{bookmarkId} {
      allow read, delete: if isAuth() && resource.data.user_email == authEmail();
      allow create: if isAuth() && request.auth.token.email_verified == true
        && request.resource.data.user_email == authEmail()
        && request.resource.data.keys().hasOnly(['user_email', 'spot_id', 'created_date']);
    }

    // ── Spot likes + saves — verified accounts, one doc per user/spot ──────
    // Aggregate counters on /spots are maintained by Cloud Functions only.
    match /spot_likes/{relationId} {
      allow read: if isAuth() && (resource.data.user_id == request.auth.uid || isSuperAdmin());
      allow create: if isAuth() && request.auth.token.email_verified == true
        && relationId == request.resource.data.spot_id + '_' + request.auth.uid
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.keys().hasOnly(['spot_id', 'user_id', 'created_date']);
      allow delete: if isAuth() && resource.data.user_id == request.auth.uid;
      allow update: if false;
    }
    match /spot_saves/{relationId} {
      allow read: if isAuth() && (resource.data.user_id == request.auth.uid || isSuperAdmin());
      allow create: if isAuth() && request.auth.token.email_verified == true
        && relationId == request.resource.data.spot_id + '_' + request.auth.uid
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.keys().hasOnly(['spot_id', 'user_id', 'created_date']);
      allow delete: if isAuth() && resource.data.user_id == request.auth.uid;
      allow update: if false;
    }

    // ── User profile / subscription state ──────────────────────────────────────
    // Subscription fields are set only by the Stripe webhook via the Admin
    // SDK (which bypasses these rules entirely) — clients get read-only
    // access to their own document and can never grant themselves a plan.
    match /users/{userId} {
      allow read: if isAuth() && request.auth.uid == userId;
      allow write: if false;
    }

    // ── Site status / maintenance banner (public read, superadmin write) ──────
    match /config/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ── Public status page (public read, superadmin write) ────────────────────
    match /status_services/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /status_incidents/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ── Admin audit log (write-only from Cloud Functions via Admin SDK,
    //     which bypasses these rules; clients may only read their own trail) ──
    match /admin_audit_log/{docId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // Phase 1 official POI authoring database. Public delivery will use
    // validated, versioned static assets. All writes go through a callable
    // that checks the signed admin claim and commits a revision transaction.
    match /official_poi_changes/{docId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }
    match /official_poi_revisions/{docId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }
    match /official_poi_audit/{docId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }
    match /official_poi_publications/{docId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // Legacy IP-ban records are not an enforcement boundary. Only the admin
    // cleanup callable may remove them; new account blocks use a separate path.
    match /ip_bans/{ip} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ── Admin-only collections ────────────────────────────────────────────────
    match /admin_pois/{docId} {
      allow read: if true;           // everyone can read custom POIs to display on map
      allow write: if isSuperAdmin();
    }

    match /admin_closures/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /admin_nav_overrides/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /admin_road_overrides/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /admin_eroute_overrides/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }


    // ── General reports: callable-only submit; admin-only moderation ─────────
    match /reports/{docId} {
      allow create: if false;
      allow read, update, delete: if isSuperAdmin();
    }
    match /report_blocks/{docId} {
      allow read, write: if false; // Admin SDK only
    }
    match /submission_blocks/{uid} {
      allow read, write: if false; // Admin SDK only
    }

    // ── Feedback (public submit, admin read) ─────────────────────────────────
    // Publicly writable collections are the easiest spam target — cap size
    // and require the shape the app actually sends.
    match /feedback/{docId} {
      // Public feedback is created only by the submitFeedback callable after
      // reCAPTCHA + IP/session rate limiting. Direct SDK writes are blocked.
      allow create: if false;
      allow read, delete: if isSuperAdmin();
    }

    match /account_deletion_requests/{userId} {
      allow read, write: if false;
    }
  }
}
