rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Spot photos: anyone can view, only signed-in users can upload, 8MB cap
    // (client already compresses to ~1920px WebP before upload — this is a hard ceiling).
    match /spots/{spotId}/{folder}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
