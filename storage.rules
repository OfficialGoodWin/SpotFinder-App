rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /community/{userId}/{fileName} {
      allow read: if true;
      // Uploads use random object names. Replacing a validated object would
      // change photos already referenced by a spot or pending POI review.
      allow create: if request.auth != null
                   && request.auth.uid == userId
                   && fileName.matches('^[A-Za-z0-9-]+\\.jpg$')
                   && request.resource.size > 0
                   && request.resource.size <= 5 * 1024 * 1024
                   && request.resource.contentType == 'image/jpeg';
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /drafts/{userId}/{draftId}/{fileName} {
      allow read: if request.auth != null
                  && request.auth.uid == userId
                  && request.auth.token.firebase.sign_in_provider != 'anonymous';
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.auth.token.firebase.sign_in_provider != 'anonymous'
                            && request.resource.size > 0
                            && request.resource.size <= 5 * 1024 * 1024
                            && fileName.matches('^[A-Za-z0-9-]+\\.jpg$')
                            && request.resource.contentType == 'image/jpeg';
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
