rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuth() { return request.auth != null; }
    function authEmail() { return request.auth.token.email; }
    function isSuperAdmin() {
      return isAuth() && request.auth.token.admin == true;
    }
    // True if none of `fields` changed between the existing doc and the
    // incoming write. Use this to lock aggregate/moderation fields so a
    // normal client write can never move them — only trusted server code
    // (Cloud Functions, running with the Admin SDK) bypasses rules entirely
    // and can update them.
    function unchanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(fields) == false;
    }
    function strLen(v, max) {
      return v is string && v.size() <= max;
    }

    // ── Public spots ─────────────────────────────────────────────────────────
    match /spots/{spotId} {
      allow read: if true;

      // Direct creates are disabled; submitSpot performs authoritative checks.
      allow create: if false && isAuth()
        && strLen(request.resource.data.title, 100)
        && strLen(request.resource.data.description, 2000)
        // Never trust a client-supplied moderation state on create.
        && request.resource.data.status in ['pending_trust', 'published']
        && (!('flag_count' in request.resource.data) || request.resource.data.flag_count == 0)
        && (!('likes_count' in request.resource.data) || request.resource.data.likes_count == 0)
        && (!('saves_count' in request.resource.data) || request.resource.data.saves_count == 0)
        // Ownership is by uid so anonymous guests can post too.
        && request.resource.data.created_by_uid == request.auth.uid
        // Community-abuse mitigation: throwaway/unverified/anonymous
        // accounts can post, but only into the pending_trust review
        // queue — never straight to published.
        && (request.auth.token.email_verified == true
            || request.resource.data.status == 'pending_trust');

      // Owners may edit their own listing content, but can never touch the
      // rating aggregates, flag/moderation state, or re-assign ownership —
      // those are only ever written by Cloud Functions with the Admin SDK.
      allow update: if isAuth() && (
        ((resource.data.created_by == authEmail() || resource.data.created_by_uid == request.auth.uid)
          && unchanged(['rating', 'rating_count', 'parking_rating', 'parking_rating_count',
                        'beauty_rating', 'beauty_rating_count', 'privacy_rating',
                        'privacy_rating_count', 'access_rating', 'access_rating_count',
                        'condition_rating', 'condition_rating_count', 'safety_rating', 'safety_rating_count',
                        'crowdedness_rating', 'crowdedness_rating_count', 'rating_schema', 'flag_count', 'status', 'created_by',
                        'created_by_uid', 'upvote_count', 'downvote_count', 'quality_score',
                        'likes_count', 'saves_count', 'has_social', 'discovery_state']))
        || isSuperAdmin()
      );

      allow delete: if isAuth() && (
        resource.data.created_by == authEmail() || resource.data.created_by_uid == request.auth.uid || isSuperAdmin()
      );
    }

    // ── Per-user spot ratings (one doc per user per spot; aggregates are  ──────
    // recomputed server-side by a Cloud Function trigger — never trust a
    // client-submitted average).
    match /spot_ratings/{ratingId} {
      allow read: if true;
      // ratingId MUST be `${spotId}_${uid}` so a user can only ever create
      // or overwrite *their own* rating for a given spot (built-in de-dupe).
      allow create, update: if isAuth()
        && request.auth.token.email_verified == true
        && ratingId == request.resource.data.spot_id + '_' + request.auth.uid
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.schema == 2
        && request.resource.data.overall is number && request.resource.data.overall >= 1 && request.resource.data.overall <= 5
        && request.resource.data.access is number && request.resource.data.access >= 0 && request.resource.data.access <= 5
        && request.resource.data.condition is number && request.resource.data.condition >= 0 && request.resource.data.condition <= 5
        && request.resource.data.safety is number && request.resource.data.safety >= 0 && request.resource.data.safety <= 5
        && request.resource.data.crowdedness is number && request.resource.data.crowdedness >= 0 && request.resource.data.crowdedness <= 5;
      allow delete: if isSuperAdmin();
    }

    // Legacy single-value ratings collection — kept read-only for existing
    // data; new writes should go through /spot_ratings above.
    match /ratings/{ratingId} {
      allow read: if isAuth();
      allow create: if false;
    }

    // ── POI community photos and ratings (public read, auth write) ────────────
    match /poi_photos/{docId} {
      allow read: if true;
      allow create: if isAuth() && request.auth.token.email_verified == true
        && request.resource.data.created_by == authEmail();
      allow delete: if isSuperAdmin() || (isAuth() && resource.data.created_by == authEmail());
    }

    match /poi_ratings/{docId} {
      allow read: if true;
      allow create: if isAuth() && request.auth.token.email_verified == true
        && request.resource.data.user_email == authEmail()
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && strLen(request.resource.data.get('comment', ''), 1000);
      allow delete: if isSuperAdmin() || (isAuth() && resource.data.user_email == authEmail());
    }

    // Social references are validated and written only by callable Cloud
    // Functions. Public clients may read active records for place details;
    // admins read every status for moderation. No client can forge provider,
    // content ID, ownership, timestamps, or moderation state.
    match /social_posts/{docId} {
      allow read: if resource.data.status == 'active' || isSuperAdmin();
      allow write: if false;
    }

    // ── Community moderation: flags (report a spot) ────────────────────────────
    // One flag per user per spot: docId MUST be `${spotId}_${reporterEmail}`.
    // flag_count / status on the target spot are recomputed server-side only.
    match /flags/{flagId} {
      allow read: if isSuperAdmin();
      allow create: if isAuth() && request.auth.token.email_verified == true
        && flagId == request.resource.data.spot_id + '_' + authEmail()
        && request.resource.data.reporter_email == authEmail()
        && request.resource.data.status == 'open'
        && request.resource.data.reason in
             ['private_property', 'dangerous', 'duplicate', 'spam', 'inaccurate_location'];
      allow update, delete: if isSuperAdmin();
    }

    // ── Votes (up/down) — one vote per user per spot ───────────────────────────
    match /votes/{voteId} {
      allow read: if isAuth();
      allow create, update: if isAuth() && request.auth.token.email_verified == true
        && voteId == authEmail() + '_' + request.resource.data.spot_id
        && request.resource.data.user_email == authEmail()
        && request.resource.data.type in ['up', 'down'];
      allow delete: if isAuth() && resource.data.user_email == authEmail();
    }

    // ── Bookmarks — private to each user ───────────────────────────────────────
    match /bookmarks/{bookmarkId} {
      allow read, delete: if isAuth() && resource.data.user_email == authEmail();
      allow create: if isAuth() && request.resource.data.user_email == authEmail();
    }

    // ── Spot likes + saves — verified accounts, one doc per user/spot ──────
    // Aggregate counters on /spots are maintained by Cloud Functions only.
    match /spot_likes/{relationId} {
      allow read: if isAuth() && (resource.data.user_id == request.auth.uid || isSuperAdmin());
      allow create: if isAuth() && request.auth.token.email_verified == true
        && relationId == request.resource.data.spot_id + '_' + request.auth.uid
        && request.resource.data.user_id == request.auth.uid;
      allow delete: if isAuth() && resource.data.user_id == request.auth.uid;
      allow update: if false;
    }
    match /spot_saves/{relationId} {
      allow read: if isAuth() && (resource.data.user_id == request.auth.uid || isSuperAdmin());
      allow create: if isAuth() && request.auth.token.email_verified == true
        && relationId == request.resource.data.spot_id + '_' + request.auth.uid
        && request.resource.data.user_id == request.auth.uid;
      allow delete: if isAuth() && resource.data.user_id == request.auth.uid;
      allow update: if false;
    }

    // ── User profile / subscription state ──────────────────────────────────────
    // Subscription fields are set only by the Stripe webhook via the Admin
    // SDK (which bypasses these rules entirely) — clients get read-only
    // access to their own document and can never grant themselves a plan.
    match /users/{userId} {
      allow read: if isAuth() && request.auth.uid == userId;
      allow write: if false;
    }

    // ── Site status / maintenance banner (public read, superadmin write) ──────
    match /config/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ── Public status page (public read, superadmin write) ────────────────────
    match /status_services/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /status_incidents/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ── Admin audit log (write-only from Cloud Functions via Admin SDK,
    //     which bypasses these rules; clients may only read their own trail) ──
    match /admin_audit_log/{docId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ── IP bans (superadmin only) ─────────────────────────────────────────────
    match /ip_bans/{ip} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // ── Admin-only collections ────────────────────────────────────────────────
    match /admin_pois/{docId} {
      allow read: if true;           // everyone can read custom POIs to display on map
      allow write: if isSuperAdmin();
    }

    match /admin_closures/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /admin_nav_overrides/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /admin_road_overrides/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /admin_eroute_overrides/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }


    // ── General reports: callable-only submit; admin-only moderation ─────────
    match /reports/{docId} {
      allow create: if false;
      allow read, update, delete: if isSuperAdmin();
    }
    match /report_blocks/{docId} {
      allow read, write: if false; // Admin SDK only
    }

    // ── Feedback (public submit, admin read) ─────────────────────────────────
    // Publicly writable collections are the easiest spam target — cap size
    // and require the shape the app actually sends.
    match /feedback/{docId} {
      // Public feedback is created only by the submitFeedback callable after
      // reCAPTCHA + IP/session rate limiting. Direct SDK writes are blocked.
      allow create: if false;
      allow read, delete: if isSuperAdmin();
    }
  }
}
