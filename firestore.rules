rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuth() { return request.auth != null; }
    function isSuperAdmin() {
      return isAuth() && request.auth.token.email == 'superadmin@spotfinder.cz';
    }

    // ── Public spots ─────────────────────────────────────────────────────────
    match /spots/{spotId} {
      allow read: if true;
      allow create: if true;

      // Owner (or superadmin) can edit their own spot's full content.
      // Any signed-in user may ALSO update only the moderation/voting counters
      // (flag_count, status→'flagged', upvote_count, downvote_count, quality_score) —
      // this is what flagSpot()/voteSpot() in firebaseClient.js write as a
      // non-owner. In production, move this to a Cloud Function trigger instead
      // of trusting the client for counter math; kept client-side here to match
      // the current no-backend architecture.
      allow update: if request.auth != null && (
        resource.data.created_by == request.auth.token.email ||
        resource.data.created_by == 'anonymous' ||
        isSuperAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['flag_count', 'status', 'upvote_count', 'downvote_count', 'quality_score'])
      );
      allow delete: if request.auth != null && (
        resource.data.created_by == request.auth.token.email || isSuperAdmin()
      );
    }

    // ── Ratings ──────────────────────────────────────────────────────────────
    match /ratings/{ratingId} {
      allow read: if isAuth();
      allow create: if isAuth();
    }

    // ── Flags (community moderation) ────────────────────────────────────────
    // Doc id is `${spotId}_${reporterEmail}` — one flag per user per spot.
    match /flags/{flagId} {
      allow read: if isSuperAdmin();
      allow create: if isAuth() && flagId == request.resource.data.spot_id + '_' + request.auth.token.email
        && request.resource.data.reporter_email == request.auth.token.email;
      allow update: if isSuperAdmin(); // resolving a flag
      allow delete: if isSuperAdmin();
    }

    // ── Votes (upvote/downvote) ─────────────────────────────────────────────
    // Doc id is `${userEmail}_${spotId}` — one vote per user per spot.
    match /votes/{voteId} {
      allow read: if isAuth();
      allow create, update: if isAuth() && voteId == request.auth.token.email + '_' + request.resource.data.spot_id
        && request.resource.data.user_email == request.auth.token.email;
      allow delete: if isAuth() && voteId == request.auth.token.email + '_' + resource.data.spot_id;
    }

    // ── Bookmarks ────────────────────────────────────────────────────────────
    // Doc id is `${userEmail}_${spotId}` — private to the bookmarking user.
    match /bookmarks/{bookmarkId} {
      allow read: if isAuth() && resource.data.user_email == request.auth.token.email;
      allow create: if isAuth() && bookmarkId == request.auth.token.email + '_' + request.resource.data.spot_id
        && request.resource.data.user_email == request.auth.token.email;
      allow delete: if isAuth() && bookmarkId == request.auth.token.email + '_' + resource.data.spot_id;
    }

    // ── POI community data (public read) ────────────
    match /poi_photos/{docId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    match /poi_ratings/{docId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // ── POI data - public read for map display ────────────────────────────────
    match /pois/{document=**} {
      allow read: if true;
      allow write: if isSuperAdmin();  // Allow superadmin to write to POIs
    }

    // ── Deleted ambient POIs (superadmin blocklist) ───────────────────────────
    match /admin_deleted_pois/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ── IP bans (superadmin only) ─────────────────────────────────────────────
    match /ip_bans/{ip} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // ── Admin-only collections ────────────────────────────────────────────────
    match /admin_pois/{docId} {
      allow read: if true;           // everyone can read custom POIs to display on map
      allow write: if isSuperAdmin();
    }

    match /admin_closures/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /admin_nav_overrides/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /admin_road_overrides/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /admin_eroute_overrides/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ── Feedback (public submit, admin read) ─────────────────────────────────
    match /feedback/{docId} {
      allow create: if true;
      allow read, delete: if isSuperAdmin();
    }
  }
}

